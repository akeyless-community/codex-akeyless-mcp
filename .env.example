# Akeyless authentication (pick one method)
AKEYLESS_ACCESS_ID=p-xxxxx
AKEYLESS_ACCESS_KEY=your-access-key
AKEYLESS_ACCESS_TYPE=access_key

# Optional — defaults shown
AKEYLESS_GATEWAY_URL=https://api.akeyless.io
AKEYLESS_ENVIRONMENT_PREFIX=/codex/my-app/local

# Runtime Authority (ARA) — required for query-db and service-execute
# Use your Akeyless Gateway configuration port (not the SaaS API URL)
AKEYLESS_ARA_GATEWAY_URL=http://127.0.0.1:8000
AKEYLESS_AGENT_ID=codex-agent

# Alternative auth: pre-issued token (short-lived sessions)
# AKEYLESS_TOKEN=
